# provision.sh 的設定範本 — 複製為 provision.env 後填入實際值。
# provision.env 已列入 .gitignore,絕不提交。
#
#   cp infra/provision.env.example infra/provision.env

# ── 必填 ─────────────────────────────────────────────────────────────────────

RESOURCE_GROUP=rg-rag-assistant
LOCATION=eastus

# 全域唯一,且只能小寫英數字。App Service 網址將為 <APP_NAME>.azurewebsites.net
APP_NAME=rag-assistant-demo

# 全域唯一,只能英數字 (不可有連字號)
ACR_NAME=ragassistantacr

# 全域唯一,3-24 字元,只能小寫英數字
STORAGE_ACCOUNT=ragassistantstore

# 全域唯一,只能小寫英數字與連字號
SEARCH_SERVICE=rag-assistant-search

# 全域唯一,3-24 字元
KEY_VAULT=kv-rag-assistant

# GitHub 儲存庫,格式 owner/repo — 用於 OIDC federated credential 的 subject
GITHUB_REPO=your-github-username/azure-rag-assistant

# ── Azure OpenAI / Document Intelligence ────────────────────────────────────
# 這兩個服務須先於 Portal 手動建立 (區域可用性與配額無法可靠自動化),
# 再把值填在這裡。留空則 provision.sh 會略過對應的機密設定。

AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-di-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ── 選填 (有合理預設值) ──────────────────────────────────────────────────────

# 留空則由 provision.sh 以 openssl 隨機產生
DJANGO_SECRET_KEY=

# Static Web App 的網址,用於後端 CORS 白名單。
# 首次執行時 SWA 還沒建立,可先留空,建好後重跑 provision.sh 或手動更新。
FRONTEND_ORIGIN=

SEARCH_INDEX_NAME=knowledge-base
STORAGE_CONTAINER=documents

# demo 環境的限流上限 — 公開帳號共用,設得比預設更嚴以控制 AI 推論成本
THROTTLE_CHAT=15/hour
THROTTLE_USER=60/hour

# 預設用 App Service 檔案系統上的 SQLite,月費 $0。
# 要示範 Azure Database for PostgreSQL 時改為該實例的連線字串
# (Flexible Server B1ms 約 $13/月)。
DATABASE_URL=
