# Azure RAG Knowledge Assistant — 環境變數範本
# 複製此檔案為 .env 並填入實際值
# 注意：.env 已列入 .gitignore，切勿將實際值提交至版本控制

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-django-secret-key-here-generate-with-python-secrets
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# 在 Azure Portal > Azure OpenAI > Keys and Endpoint 取得
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# gpt-4.1 系列需 2024-10-21 (GA) 或更新版本
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Azure AI Search ───────────────────────────────────────────────────────────
# 在 Azure Portal > AI Search > Keys 取得
AZURE_SEARCH_ENDPOINT=https://<your-resource>.search.windows.net
AZURE_SEARCH_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX_NAME=knowledge-base

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# 在 Azure Portal > Storage Account > Access Keys 取得
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=documents
AZURE_STORAGE_SAS_EXPIRY_HOURS=1

# ── Azure Document Intelligence ───────────────────────────────────────────────
# 在 Azure Portal > Document Intelligence > Keys and Endpoint 取得
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-document-intelligence-key>

# ── Azure Key Vault (生產環境使用) ─────────────────────────────────────────────
# 設定此變數後，以下 5 個機密改由 Key Vault 供應，取不到才回退至本檔案：
#   SECRET_KEY / AZURE_OPENAI_KEY / AZURE_SEARCH_KEY
#   AZURE_STORAGE_CONNECTION_STRING / AZURE_DOCUMENT_INTELLIGENCE_KEY
# Key Vault 的 secret 名稱＝環境變數名轉小寫、底線改連字號，例如：
#   AZURE_OPENAI_KEY → azure-openai-key
# 認證使用 DefaultAzureCredential：
#   生產 = App Service 的 Managed Identity；本機 = `az login` 的開發者認證
# 留空（預設）時完全不連線 Key Vault，維持純 .env 流程。
# AZURE_KEY_VAULT_URL=https://<your-vault>.vault.azure.net/

# ── RAG 參數 ──────────────────────────────────────────────────────────────────
# 通常不需修改，調整時請同步更新 CLAUDE.md
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=128
# RAG_TOP_K=5
# RAG_MAX_QUERY_LENGTH=2000
